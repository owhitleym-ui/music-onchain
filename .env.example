# Chain (Arc testnet)
CHAIN_RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_CHAIN_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.arc.io

# Keys (TEST KEYS ONLY - never commit real values)
DEPLOYER_PRIVATE_KEY=
ORACLE_PRIVATE_KEY=
FAUCET_PRIVATE_KEY=

# Roles (used by contracts/script)
ORACLE_ADDRESS=
TREASURY_ADDRESS=
ARTIST_ADDRESS=
WINDOW_SECONDS=900

# Deployed addresses
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_SONG_REGISTRY_ADDRESS=
NEXT_PUBLIC_COMPETITION_ADDRESS=

# Services
NEXT_PUBLIC_PRIVY_APP_ID=          # empty = "Sign in" makes a local test wallet in the browser (development only)
PRIVY_APP_SECRET=                  # server-side access-token verification for /api/faucet
QUICKNODE_STREAMS_WEBHOOK_SECRET=  # the Stream's security token (Stream settings tab)
ADMIN_SECRET=                      # protects /api/admin/* and the /admin page
CRON_SECRET=
YOUTUBE_API_KEY=                   # optional: /api/admin/youtube view-count pre-fill
LASTFM_API_KEY=

# Backend (apps/web). Next.js reads env from apps/web/.env.local locally and from Vercel in production.
FAUCET_DRIP_USDC=10                # test USDC per new user (covers entry fees and gas on Arc)
FAUCET_ALLOW_UNAUTHENTICATED=false # local dev only: lets /api/faucet take { address } without Privy. Ignored in production.
SUPABASE_URL=                      # optional: without it, reads fall back to the chain and the webhook returns 503
SUPABASE_SERVICE_ROLE_KEY=         # server only. Never prefix with NEXT_PUBLIC_
COMPETITION_DEPLOY_BLOCK=          # block the Competition contract was deployed in (Stream start block)
